Screen {
	background: #181926;
}

Static {
	color: #e64553;
}

Button {
	background: transparent;
	color: #e64553;
	border: round #e5c890;
}

#layout {
	width: 100%;
	height: 100%;
}

.center {
	width: 100%;
	height: 1fr;
	align: center middle;
}

.center Static {
	width: 100%;
	text-align: center;
}

.center Horizontal {
	width: 100%;
	height: auto;
	align: center middle;
}

#about {
	margin-bottom: 1;
	border: none;
}

#logo {
	width: 100%;
	color: #e5c890;
	text-align: center;
}