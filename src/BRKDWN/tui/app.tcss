$accent: #e64553;
$primary: #e5c890;
$base: #181926;
$surface: #1e2030;
$text: #cad3f5;

#layout { height: 1fr; }

Static {
	color: $accent;
}

.button {
	background: transparent;
	color: $accent;
	border: round $primary;
}

#layout {
	width: 100%;
	height: 100%;
}

.center {
	width: 100%;
	height: 1fr;
	align: center middle;
}

.center Static {
	width: 100%;
	text-align: center;
}

.center Horizontal {
	width: 100%;
	height: auto;
	align: center middle;
}

#about-button {
	margin-bottom: 1;
	border: none;
}

#logo {
	width: 100%;
	color: $primary;
	text-align: center;
}

FileSelector {
	align: center middle;
}

.dialog {
	width: 80%;
	height: 75%;
	padding: 1 2;
	border: round $primary;
}

.dialog-buttons {
  background: transparent;
  align: center middle;
	color: $accent;
	border: round $primary;
}

/* DirectoryTree classes overrides */
DirectoryTree {
	scrollbar-size-vertical: 1;
	scrollbar-size-horizontal: 1;
}

.tree--cursor {
	background: $accent;
	color: $base;
}

DataTable {
	scrollbar-size-vertical: 1;
	scrollbar-size-horizontal: 1;
	height: 1fr;
}

.prevent_footer_overlap {
	dock: none;
	height: 1;
}